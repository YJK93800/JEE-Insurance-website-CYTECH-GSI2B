<%-- Tableau de paiements réutilisable. La page définit "paymentList" (List<Payment>) avant l'inclusion.
     Payment : dueDate, paymentDate (null tant que non payé), contract (number), method (PaymentMethod{label}, null si non payé),
               amount, status (PaymentStatus{label}) --%>
<c:choose>
  <c:when test="${empty paymentList}"><p class="empty">Aucun paiement à afficher.</p></c:when>
  <c:otherwise>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Échéance</th><th>Contrat</th><th class="right">Montant</th><th>Statut</th><th>Payé le</th><th>Mode</th></tr></thead>
        <tbody>
          <c:forEach items="${paymentList}" var="p">
            <tr>
              <td class="strong"><ui:date value="${p.dueDate}" /></td>
              <td class="muted"><c:out value="${p.contract.number}" /></td>
              <td class="right strong"><ui:amount value="${p.amount}" /></td>
              <td><ui:status value="${p.status}" label="${p.status.label}" /></td>
              <td><ui:date value="${p.paymentDate}" /></td>
              <td class="muted"><c:out value="${empty p.method ? '—' : p.method.label}" /></td>
            </tr>
          </c:forEach>
        </tbody>
      </table>
    </div>
  </c:otherwise>
</c:choose>
