<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>AssurCY2000</display-name>

    <!-- Les filtres s'exécutent dans l'ORDRE des <filter-mapping> : CSRF → connexion → rôle -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.assurcy2000.security.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.assurcy2000.security.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.assurcy2000.security.RoleFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Toutes les vues et leurs fragments inclus (.jspf) sont lus en UTF-8.
         Sans ça, Tomcat lit les .jspf en ISO-8859-1 : « Déclaré » s'affiche « DÃ©clarÃ© ». -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- <secure>true</secure> à activer dès que le site est servi en HTTPS -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>   <!-- jamais de jsessionid dans l'URL -->
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/error.jsp</location>
    </error-page>
</web-app>
